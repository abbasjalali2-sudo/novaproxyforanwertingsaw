{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaproxyforanwertingsaw",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4f80b622-ac06-44db-a3c2-f88be6ee541f","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d400ca38e7a54c0680d1a1034defc031" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
